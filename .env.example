# Copy to .env and fill in real values. Never commit .env.

# SQLite database file. Relative paths resolve from prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Google Maps browser key (Maps JavaScript API). Restrict to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# Google Maps server key (Places API New). Requires billing enabled on the project.
GOOGLE_MAPS_API_KEY=""

# Public Wikimedia data retrieval (English Wikipedia; no key needed).
WIKIMEDIA_ENABLED="true"
